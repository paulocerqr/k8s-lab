#cloud-config
# Bootstrap mínimo (K17): usuário administrativo + Tailscale. O resto é com o Ansible.
hostname: ${hostname}
preserve_hostname: false

users:
  - name: ${usuario}
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true

package_update: true
packages:
  - curl
  - ca-certificates

runcmd:
  - curl -fsSL https://tailscale.com/install.sh | sh
  - >-
    tailscale up
    --auth-key=${tailscale_auth_key}
    --hostname=${hostname}
    --advertise-tags=${tailscale_tag}
    --ssh
  # a auth key fica no user-data; depois do registro ela não é mais necessária
  - rm -f /var/lib/cloud/instance/user-data.txt /var/lib/cloud/instance/user-data.txt.i
